# AI core env (server only — never NEXT_PUBLIC_, never committed)
# Next.js proxy (web-app_v1.0)
AI_CORE_BASE=http://127.0.0.1:8765
AI_CORE_MODE=hermes
# AI_CORE_BASE=http://127.0.0.1:8642
# AI_CORE_MODE=openai
# AI_CORE_KEY=<gateway api_server key, openai mode only>
# AI_CORE_MODEL=hermes-agent
AI_CORE_TIMEOUT_MS=90000
AI_RATE_PER_MIN=30
# Tutor pilot: per-user tutor turns/min (students hammer; system prompt ~20-30k).
TUTOR_RATE_PER_MIN=10
# Tutor pilot consent allowlist (server-only, git-ignored .env — NEVER the repo):
# comma-separated login user_account_ids collected by the school on signed opt-in.
# "*" = whole-cohort mode, only with the school letter on file (see erp-ops/pilot-pack/).
# TUTOR_CONSENT_IDS=885283,885284
# erp-mcp (ai-agent/erp-mcp/.env — see .env.example)
# ERP_API_BASE=https://api.infoeight.com
# ERP_API_PATH=/api
# ERP_MAX_PAGE=50
# ERP_MAX_PAGES=2
# Uploads RAG (central Postgres vector store, per-school rows).
# Server only — never NEXT_PUBLIC_, never committed. Same var must exist in
# the Next.js runtime env AND the erp-mcp/core env (both read it).
# vector_DB=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Fallback for local dev only (no vector_DB): SQLite file in RAG_STORE_DIR.
# RAG_STORE_DIR=D:/WORK/web-app_v1.0/ai-agent/library
# RAG_TOP_K=3
# RAG_MAX_CHUNK_CHARS=1200
# Optional dense embedder upgrade: command receiving {"texts":[...]} on stdin,
# returning {"vectors":[[...],...]} on stdout. Unset = built-in hash embedder.
# RAG_EMBED_CMD=
# Core memory layer — ai-memory (Hindsight server: retain/recall/reflect,
# bank per tenant+role+login) for all roles.
# Server only — never NEXT_PUBLIC_, never committed. Unset = memory gracefully
# off (chat + RAG keep working without recall/writes).
# HINDSIGHT_BASE_URL=http://127.0.0.1:8888
# HINDSIGHT_API_PREFIX=/v1/default
# HINDSIGHT_API_KEY=<bearer key if the server enforces auth; else omit>
# HINDSIGHT_TIMEOUT_MS=12000
# HINDSIGHT_WRITE_MODE=batched   (batched = background retain (default);
#                                 all = synchronous retain; off = no writes)


